# ───────────────────────── Dishky API — environment ─────────────────────────
# Copy to .env (never commit .env). Every value below is a placeholder.

# ── Core ──
NODE_ENV=production
PORT=4000
# Your own MongoDB connection string. Use a dedicated database user.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Comma-separated browser origins allowed to call the API with cookies:
# the dashboard, the marketing site, and (for local dev) the dev servers.
ALLOWED_ORIGINS=https://app.dishky.com,https://www.dishky.com,https://ops.dishky.com,https://dev.dishky.com,http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
# Proxy hops in front of the API (e.g. 1 behind Render/another reverse proxy)
TRUST_PROXY_HOPS=1

# ── Public URLs (used in emails, redirects, QR links) ──
PUBLIC_SITE_URL=https://www.dishky.com
ADMIN_APP_URL=https://app.dishky.com
# Developer Panel (Dishky staff) base URL — used in invitation / password-reset e-mails
DEV_PANEL_URL=https://dev.dishky.com
PUBLIC_API_URL=https://api.dishky.com

# ── Encrypts each restaurant's own payment-gateway secrets at rest ──
# 32+ random characters, e.g.:  openssl rand -base64 48   (keep it stable! changing it
# makes saved restaurant gateway keys unreadable)
SETTINGS_ENCRYPTION_KEY=

# ── Subscription billing (Dishky charging restaurant owners) ──
# razorpay | mock.  "mock" is for development/tests and is refused in production
# unless BILLING_ALLOW_MOCK=true.
BILLING_PROVIDER=razorpay
BILLING_ALLOW_MOCK=false
# Dishky's OWN Razorpay account. Webhook URL to register:
#   https://api.dishky.com/platform/webhooks/razorpay
# (events: subscription.activated, subscription.charged, subscription.halted,
#  subscription.pending, subscription.cancelled, subscription.completed, payment.failed)
RAZORPAY_BILLING_KEY_ID=
RAZORPAY_BILLING_KEY_SECRET=
RAZORPAY_BILLING_WEBHOOK_SECRET=
TRIAL_DAYS=14
PAST_DUE_GRACE_DAYS=7

# ── Restaurants' customer payments (UPI QR) ──
# Each restaurant enters its own Razorpay keys in its dashboard (Bank Accounts page).
# These three are ONLY a fallback for a migrated single-restaurant install and can be left empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Restaurant slug that the old un-suffixed webhook URL /payments/webhook belongs to (migration only)
LEGACY_WEBHOOK_RESTAURANT=

# ── Email (password resets, owner and staff) ──
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dishky <no-reply@dishky.com>"
FRONTEND_URL=https://app.dishky.com

# ── Abuse limits (optional) ──
SIGNUP_RATE_LIMIT_MAX=10
OWNER_AUTH_RATE_LIMIT_MAX=20
# Shared store for rate limiting across multiple instances (otherwise in-memory)
REDIS_URL=

# ── Misc (optional) ──
AISENSY_API_KEY=
MEMO_TZ_OFFSET=+05:30
# Keep-alive ping for hosts that sleep idle services
SELF_URL=

# ── Super admin console (ops.dishky.com) ──
# Add the console's origin to ALLOWED_ORIGINS too, e.g. https://ops.dishky.com
# Optional comma-separated IP allow-list; other IPs get a 404 on /superadmin
PLATFORM_ADMIN_ALLOWED_IPS=
# Logins per 15 minutes per IP
SUPERADMIN_LOGIN_RATE_LIMIT_MAX=10
# Database capacity (MB) shown as a meter on the Overview page (e.g. 512 for Atlas M0)
DB_STORAGE_LIMIT_MB=

# ── Purchase & Inventory ──
# Stock posting needs MongoDB transactions (replica set / Atlas). Setting this to true lets it run on a
# standalone database WITHOUT atomicity — local development and tests only, never production.
INVENTORY_ALLOW_NO_TRANSACTIONS=false
