    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/((?!(?:admin|app|www|login|logout|signup|register|account|billing|pricing|plans|features|platform|user-panel|admin-panel|promotions|solutions|branches|resources|about|contact|book-demo|legal|privacy|terms|security|cookies|help|support|docs|blog|status|demo|dashboard|checkout|sso|assets|public|brand|r|t|s|dishky|root|null|undefined|new|settings|staff|orders|menu|welcome|foodcategory|events|profile|thankyou|assets|brand)(?:/|$)).+)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
